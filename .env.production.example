# Copy to .env.production and fill in real values. Never commit the filled-in file.

# --- Database (AWS RDS Postgres) ---
EDOVA_DB_DSN=postgresql://<user>:<password>@<rds-endpoint>:5432/edtech_platform

# --- Auth ---
EDOVA_JWT_SECRET=<generate a long random secret>

# --- S3 (shared by backend and video-engine -- same bucket, same prefix convention) ---
EDOVA_S3_BUCKET=innuxai-edova-coteacher
EDOVA_S3_REGION=ap-south-1

# --- AWS credentials ---
# On ECS/Fargate, leave these blank and attach an IAM task role with
# s3:PutObject/GetObject on EDOVA_S3_BUCKET and polly:SynthesizeSpeech instead --
# the AWS SDKs (boto3 and @aws-sdk/*) pick that up automatically. Only set these
# two if running outside AWS (e.g. this compose file on a laptop).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Video engine (Amazon Polly voice) ---
EDOVA_POLLY_VOICE=Joanna
