# --- project ---
# Entire temp/ folder is intentionally untracked (scratch/temporary files, includes
# temp/migration/ content-staging area with >1GB of media). NOTE: schema.sql and
# migration_*.sql live only there — they are NOT versioned. Copy them elsewhere if that changes.
temp/

# Local tool binaries (ffmpeg static build for the dev transcode pipeline, ~170MB)
tools/

# Legacy pilot repo (~900MB), kept locally for reference only during the SaaS port.
# Most of its files have already been migrated into this repo; do not commit it.
edova-coteacher-lms-master/

# --- secrets ---
.env
.env.*
!.env.example

# --- python ---
__pycache__/
*.pyc
.venv/
venv/

# --- node / frontend ---
node_modules/
frontend/dist/
storefront/dist/
edova-authoring-app/dist/

# --- playwright (e2e test artifacts) ---
edova-authoring-app/test-results/
edova-authoring-app/playwright-report/
frontend/test-results/
frontend/playwright-report/

# --- dev server logs ---
backend/*.log
frontend/*.log

# --- android / capacitor build output ---
frontend/android/app/build/
frontend/android/.gradle/
frontend/android/local.properties

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
