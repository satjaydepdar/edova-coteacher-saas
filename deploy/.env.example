# Copy to .env and fill in. Never commit .env.
DB_PASSWORD=change-me-long-random
JWT_SECRET=        # openssl rand -hex 32 — REQUIRED: the API refuses to boot without it
DOMAIN=api.example.com
# production: API fails fast on default JWT secret or wildcard CORS
ENVIRONMENT=production
# Comma-separated browser origins allowed to call the API.
# capacitor://localhost = Android app, http://localhost = iOS app dev.
CORS_ORIGINS=capacitor://localhost,http://localhost
AWS_REGION=ap-south-1
